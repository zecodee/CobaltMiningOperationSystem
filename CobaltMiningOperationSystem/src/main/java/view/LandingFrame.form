              <SubComponents>
                <Component class="javax.swing.JLabel" name="lblTentangKicker">
                  <Properties>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="12" style="1"/>
                    </Property>
                    <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                      <Color blue="6d" green="88" red="ab" type="rgb"/>
                    </Property>
                    <Property name="text" type="java.lang.String" value="&#x25c6;  TENTANG PERUSAHAAN"/>
                  </Properties>
                </Component>
                <Component class="javax.swing.JLabel" name="lblTentangTitle">
                  <Properties>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="26" style="1"/>
                    </Property>
                    <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                      <Color blue="42" green="2b" red="1a" type="rgb"/>
                    </Property>
                    <Property name="text" type="java.lang.String" value="PT. COBALT"/>
                  </Properties>
                </Component>
                <Component class="javax.swing.JLabel" name="lblTentangLead">
                  <Properties>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="13" style="2"/>
                    </Property>
                    <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                      <Color blue="69" green="56" red="47" type="rgb"/>
                    </Property>
                    <Property name="text" type="java.lang.String" value="&lt;html&gt;Perusahaan pertambangan kobalt dengan pengelolaan operasional yang terpusat dan berkelanjutan.&lt;/html&gt;"/>
                  </Properties>
                </Component>
                <Component class="javax.swing.JLabel" name="lblTentangP1">
                  <Properties>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="13" style="0"/>
                    </Property>
                    <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                      <Color blue="69" green="56" red="47" type="rgb"/>
                    </Property>
                    <Property name="text" type="java.lang.String" value="&lt;html&gt;PT. Cobalt merupakan perusahaan pertambangan yang mengelola kegiatan &lt;b&gt;produksi tambang&lt;/b&gt;, &lt;b&gt;pengangkutan hasil tambang&lt;/b&gt;, penggunaan kendaraan operasional dan driver, hingga &lt;b&gt;pemantauan kondisi lingkungan&lt;/b&gt;. Seluruh kegiatan berjalan pada lokasi PIT (area penambangan) dan STOCKPILE (penampungan material) yang tersebar di berbagai titik operasional.&lt;/html&gt;"/>
                  </Properties>
                </Component>
                <Component class="javax.swing.JLabel" name="lblTentangP2">
                  <Properties>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="13" style="0"/>
                    </Property>
                    <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                      <Color blue="69" green="56" red="47" type="rgb"/>
                    </Property>
                    <Property name="text" type="java.lang.String" value="&lt;html&gt;Setiap hari, tim operasional mencatat hasil produksi material seperti &lt;i&gt;Cobalt Ore&lt;/i&gt; dan &lt;i&gt;Overburden&lt;/i&gt;, merencanakan pengangkutan menggunakan armada dump truck, serta memantau parameter lingkungan secara terperinci sesuai dengan standar kesehatan. Data yang saling berkaitan tersebut dikelola secara terstruktur agar operasional berjalan aman, efektif, dan berkelanjutan.&lt;/html&gt;"/>
                  </Properties>
                </Component>
                <Component class="javax.swing.JLabel" name="lblTentangP3">
                  <Properties>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="13" style="0"/>
                    </Property>
                    <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                      <Color blue="69" green="56" red="47" type="rgb"/>
                    </Property>
                    <Property name="text" type="java.lang.String" value="&lt;html&gt;Melalui digitalisasi proses operasional, PT. Cobalt mendukung prinsip pertambangan yang bertanggung jawab penuh yang sejalan dengan &lt;b&gt;SDG 8.&lt;/b&gt; (Pekerjaan Layak dan Pertumbuhan Ekonomi), &lt;b&gt;SDG 12.&lt;/b&gt; (Konsumsi dan Produksi yang Bertanggung Jawab), serta &lt;b&gt;SDG 13.&lt;/b&gt; (Penanganan Perubahan Iklim).&lt;/html&gt;"/>
                  </Properties>
                </Component>
                <Component class="javax.swing.JLabel" name="imgTentang">
                  <Properties>
                    <Property name="icon" type="javax.swing.Icon" editor="org.netbeans.modules.form.editors2.IconEditor">
                      <Image iconType="3" name="/images/landing/tentang_display.png"/>
                    </Property>
                  </Properties>
                </Component>
